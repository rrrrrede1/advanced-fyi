---
import '../styles/global.css';
import { SITE_TITLE, SITE_TAGLINE } from '../lib';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_TAGLINE } = Astro.props;
const path = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} — ${SITE_TITLE}` : SITE_TITLE}</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a class="logo" href="/">{SITE_TITLE}</a>
        <nav>
          <a href="/" class:list={{ active: path === '/' }}>Home</a>
          <a href="/explore" class:list={{ active: path.startsWith('/explore') }}>Explore</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">© All rights reserved — {SITE_TITLE}</footer>
    </div>
  </body>
</html>
